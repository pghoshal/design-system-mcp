{
  "color": {
    "action": {
      "primary": {
        "$value": "{color.blue.500}",
        "$type": "color",
        "$description": "Primary action color"
      },
      "primaryHover": { "$value": "{color.blue.600}", "$type": "color" },
      "danger": {
        "$value": "{color.red.500}",
        "$type": "color",
        "$description": "Destructive action color"
      },
      "legacyPrimary": {
        "$value": "{color.action.primary}",
        "$type": "color",
        "$description": "Deprecated primary action alias",
        "$deprecated": "Use token:color.action.primary instead.",
        "$replacement": "token:color.action.primary"
      }
    },
    "surface": {
      "default": { "$value": "{color.neutral.0}", "$type": "color" },
      "inverse": { "$value": "{color.neutral.900}", "$type": "color" }
    },
    "text": {
      "primary": { "$value": "{color.neutral.900}", "$type": "color" },
      "inverse": { "$value": "{color.neutral.0}", "$type": "color" }
    }
  }
}
