# Transport mode: "http" (default) or "stdio"
DS_MCP_MODE=http

# Source mode: "git" (default) or "local"
DS_MCP_SOURCE_MODE=git

# Required when DS_MCP_SOURCE_MODE=git
DS_MCP_SOURCE_URL=https://github.com/your-org/design-system.git
DS_MCP_SOURCE_BRANCH=main

# Required when DS_MCP_SOURCE_MODE=local
# DS_MCP_SOURCE_PATH=/Users/you/work/design-system

# Where the Git checkout lives
# DS_MCP_CACHE_DIR=~/.cache/ds-mcp

# Refresh interval in seconds (min 30, default 300)
DS_MCP_REFRESH_INTERVAL_SEC=300

# HTTP transport settings
PORT=3000
LOG_LEVEL=info

# Auth (optional). When set to "apikey", DS_MCP_API_KEYS must be provided.
DS_MCP_AUTH_MODE=none
# Comma-separated bcrypt hashes
# DS_MCP_API_KEYS=$2b$10$...,$2b$10$...

# Bearer token for POST /admin/refresh (HTTP mode)
# DS_MCP_ADMIN_TOKEN=...

# Optional Git auth for HTTPS clone
# GIT_AUTH_TOKEN=ghp_...
