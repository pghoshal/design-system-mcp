{
  "name": "ds-mcp-server",
  "version": "0.0.1",
  "description": "Single-instance MCP server for an organization's UX design system",
  "type": "module",
  "private": true,
  "engines": {
    "node": ">=22.0.0",
    "pnpm": ">=9.0.0"
  },
  "packageManager": "pnpm@9.12.0",
  "main": "dist/index.js",
  "bin": {
    "ds-mcp-server": "dist/index.js"
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "start": "node dist/index.js",
    "validate": "tsx src/validate-cli.ts",
    "dev": "tsx watch src/index.ts",
    "typecheck": "tsc --noEmit",
    "lint": "biome check src tests",
    "lint:fix": "biome check --write src tests",
    "format": "biome format --write src tests",
    "test": "vitest run",
    "test:unit": "vitest run tests/unit",
    "test:integration": "vitest run tests/integration",
    "test:watch": "vitest"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.0.4",
    "fastify": "^5.0.0",
    "zod": "^3.23.8",
    "style-dictionary": "^4.1.4",
    "gray-matter": "^4.0.3",
    "unified": "^11.0.5",
    "remark-parse": "^11.0.0",
    "remark-stringify": "^11.0.0",
    "minisearch": "^7.1.0",
    "lru-cache": "^11.0.1",
    "simple-git": "^3.27.0",
    "pino": "^9.4.0",
    "uuid": "^10.0.0",
    "typescript": "^5.6.2"
  },
  "devDependencies": {
    "@biomejs/biome": "^1.9.2",
    "@types/node": "^22.7.0",
    "@types/uuid": "^10.0.0",
    "tsx": "^4.19.1",
    "vitest": "^2.1.1"
  }
}
